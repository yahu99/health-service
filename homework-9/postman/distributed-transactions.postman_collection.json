{
  "info": {
    "_postman_id": "493a5ea1-4cd8-4738-a9fe-410bfce5ec51",
    "name": "Homework 9 — distributed transaction Saga",
    "description": "Public API scenario: successful order, payment/stock/courier failures, compensation and idempotency. Requires the homework-9 services and previous Auth/Profile/BFF services. Each run creates a new user. Warehouse demo stock is finite.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
