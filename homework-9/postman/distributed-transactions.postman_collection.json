              "    pm.expect(order.status).to.eql(\"CANCELLED\");",
              "    pm.expect(order.reason).to.eql(\"NO_COURIER_AVAILABLE\");",
              "    const steps = Object.fromEntries(order.steps.map(s => [s.step, s.status]));",
              "  pm.expect(steps.BILLING).to.eql(\"COMPENSATED\");",
              "  pm.expect(steps.WAREHOUSE).to.eql(\"COMPENSATED\");",
              "  pm.expect(steps.DELIVERY).to.eql(\"REJECTED\");",
              "  });",
              "}"
            ]
          }
        }
      ],
