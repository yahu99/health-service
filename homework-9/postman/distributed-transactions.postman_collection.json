              "pm.collectionVariables.set(\"pollCount_order_success\", count);",
              "if (order.status === \"PROCESSING\" || order.status === \"COMPENSATING\") {",
              "  if (count < 120) pm.execution.setNextRequest(pm.info.requestName);",
              "  else pm.test(\"Saga completed within 120 polls\", () => pm.expect(order.status).to.eql(\"CONFIRMED\"));",
              "} else {",
              "  pm.test(\"Final order status and saga steps\", () => {",
              "    pm.expect(order.orderId).to.eql(Number(pm.collectionVariables.get(\"order_success\")));",
              "    pm.expect(order.status).to.eql(\"CONFIRMED\");",
              "    pm.expect(order.reason).to.eql(null);",
              "    const steps = Object.fromEntries(order.steps.map(s => [s.step, s.status]));",
              "  pm.expect(steps.BILLING).to.eql(\"SUCCEEDED\");",
              "  pm.expect(steps.WAREHOUSE).to.eql(\"SUCCEEDED\");",
